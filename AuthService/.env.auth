
ASPNETCORE_ENVIRONMENT=Development

Jwt__Issuer=CloudClientManagement
Jwt__Audience=CloudClientManagement
Jwt__Key=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET_AT_LEAST_32_BYTES

SeedAdmin__Username=admin
SeedAdmin__Email=admin@example.com
SeedAdmin__Password=REPLACE_WITH_A_STRONG_PASSWORD

ConnectionStrings__DefaultConnection=Server=host.docker.internal,1433;Database=CloudClientManagementAuthDb;User Id=YOUR_SQL_USER;Password=YOUR_SQL_PASSWORD;Encrypt=True;TrustServerCertificate=True;